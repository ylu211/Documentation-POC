{
  "compilerOptions": {
      "experimentalDecorators": true,
      "emitDecoratorMetadata": true,
      "incremental": true,
      "target": "ES2020",
      "module": "nodenext",
      "lib": ["ES2020", "DOM"],
      "strict": true,
      "strictPropertyInitialization": false,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "sourceMap": true,
      "declaration": true,
      "typeRoots": ["./node_modules/@types", "./@types"],
      "moduleResolution": "nodenext",
      "declarationMap": true,
      "outDir": "./dist",
      "baseUrl": "./"
  }
}